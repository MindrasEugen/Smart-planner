# Copia in .env per lo sviluppo locale. In produzione, queste vanno
# configurate come variabili d'ambiente nel dashboard Render del Web Service
# e del Cron Job (non committare mai un .env reale).

# Obbligatoria: senza questa, ogni orario di notifica calcolato e' sbagliato
# (i container Render sono UTC di default). Vedi commento in src/index.js.
TZ=Europe/Rome

# Segreto condiviso col client (VITE_SYNC_SECRET nel build del frontend).
# Genera un valore casuale, es.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SYNC_SECRET=

# Genera una sola volta in locale: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:mandraseugen@gmail.com

# Origine consentita per CORS (il dominio del frontend). Piu' valori separati da virgola.
ALLOWED_ORIGIN=http://localhost:5173,https://smart-planner-vjgl.onrender.com

# Connection string Postgres di Supabase (Project Settings > Database >
# Connection string > "Transaction" pooler, porta 6543 -- necessaria per
# funzionare da un ambiente serverless/free-tier come Render). Es.:
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Porta locale (Render la imposta da solo in produzione)
PORT=3000

# Finestra (minuti) entro cui un'occorrenza e' considerata "dovuta ora" dal tick.
# Deve essere >= alla frequenza del Cron Job, altrimenti si rischia di perdere
# occorrenze tra un tick e l'altro. Default 5.
TICK_WINDOW_MINUTES=5

# Quick Add AI (estrazione task da testo libero, vedi PLAN.md ROAD-06).
# Opzionale: senza questa, /api/quick-add risponde sempre "AI non configurata"
# ma il resto del server (notifiche push) funziona normalmente.
# Genera la chiave su https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modello Gemini da usare. Default: gemini-3.6-flash (veloce ed economico,
# sufficiente per estrarre pochi campi strutturati da una frase breve;
# gemini-2.5-flash non è più disponibile per nuovi utenti al 2026-08-26).
GEMINI_MODEL=gemini-3.6-flash
# Limite di quick add al giorno per dispositivo (non per utente: non esiste
# ancora un concetto di account, vedi PLAN.md ROAD-07). Default 5.
QUICK_ADD_DAILY_LIMIT=5
