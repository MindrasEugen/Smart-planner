# Cloud-sync / Autenticazione (in arrivo, progetto Supabase "todo-list-app", condiviso con altre app:
# le tabelle di questa app hanno prefisso AAA4_agenda_)
# Queste variabili servono per la futura funzionalità di login/registrazione e sincronizzazione dati
# su più dispositivi. Per ora sono opzionali e non ancora usate dall'app.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend (server/ su Render): Web Push + Quick Add AI. Valori iniettati nel bundle
# al momento della build, quindi servono anche per compilare l'app Android
# (npm run android:sync). VITE_SYNC_SECRET = SYNC_SECRET del server.
VITE_SYNC_API_URL=https://agenda-push-server.onrender.com
VITE_SYNC_SECRET=
VITE_VAPID_PUBLIC_KEY=
